{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nightshift",
  "version": "0.1.0",
  "identifier": "dev.neil.nightshift",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "NIGHTSHIFT//OS", "width": 1440, "height": 900, "decorations": false }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
